#!/bin/bash

TYPE=$1
NAME=$2
STATE=$3

PIHOLE_URL="http://$PRIMARY_IP:82"
DOCKER_SOCKET="/var/run/docker.sock"

# The osixia/keepalived image has no `docker` CLI binary, only curl - so we
# talk to the local Docker Engine API over its mounted unix socket instead.
docker_action() {
  local action=$1  # "start" or "stop"
  local container=$2

  local status
  status=$(curl -s -o /dev/null -w '%{http_code}' -X POST \
    --unix-socket "$DOCKER_SOCKET" \
    "http://localhost/containers/${container}/${action}")

  # 204 = success, 304 = already in the requested state - both are fine
  if [ "$status" != "204" ] && [ "$status" != "304" ]; then
    logger "keepalived notify: failed to ${action} ${container} (http $status)"
  fi
}

pihole_set_dhcp() {
  local active=$1  # "true" or "false"

  local auth_response
  auth_response=$(curl -s -X POST "$PIHOLE_URL/api/auth" \
    -H "Content-Type: application/json" \
    -d "{\"password\": \"$PIHOLE_WEBPASSWORD\"}")

  local sid csrf
  sid=$(echo "$auth_response" | sed -n 's/.*"sid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  csrf=$(echo "$auth_response" | sed -n 's/.*"csrf"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

  if [ -z "$sid" ]; then
    logger "keepalived notify: failed to authenticate with Pi-hole at $PIHOLE_URL"
    return 1
  fi

  curl -s -X PATCH "$PIHOLE_URL/api/config" \
    -H "X-FTL-SID: $sid" \
    -H "X-FTL-CSRF: $csrf" \
    -H "Content-Type: application/json" \
    -d "{\"config\":{\"dhcp\":{\"active\":$active}}}"

  curl -s -X DELETE "$PIHOLE_URL/api/auth" \
    -H "X-FTL-SID: $sid" \
    -H "X-FTL-CSRF: $csrf"
}

case $STATE in
  "MASTER")
    # Wait for pihole to be ready
    for i in $(seq 1 12); do
      if curl -s "http://localhost:82/api/auth" > /dev/null 2>&1; then
        break
      fi
      sleep 5
    done
    pihole_set_dhcp true
#    docker_action start nginx-proxy-manager
#    docker_action start rsync
    docker_action start nebula-sync
    docker_action start rathole-client
    # Stop containers on the other node via SSH
    ssh -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -i /etc/keepalived/ssh_key \
        ${SSH_USER}@${SECONDARY_IP} \
        "docker stop nebula-sync rathole-client" || true
    ;;
  "BACKUP"|"FAULT")
    sleep 5
    # Re-check state before stopping - if we're now MASTER, abort
    CURRENT_STATE=$(ip addr show | grep -q "inet ${KEEPALIVED_VIRTUAL_IP}/" && echo "MASTER" || echo "BACKUP")
    if [ "$CURRENT_STATE" = "MASTER" ]; then
      logger "keepalived notify: state changed to MASTER before stop completed, aborting"
      exit 0
    fi
#    docker_action stop rsync
    docker_action stop nebula-sync
#    docker_action stop nginx-proxy-manager
    docker_action stop rathole-client
    pihole_set_dhcp false
    ;;
  *)
    logger "keepalived notify: unknown state $STATE"
    exit 1
    ;;
esac

logger "keepalived notify: transitioned to $STATE"
exit 0